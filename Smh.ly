\version "2.24.0"

% ============================================================
% تبدیل نت عددی هندپن (D Kurd / D minor) به LilyPond
% ------------------------------------------------------------
% نگاشت شماره‌ها به نت (اکتاو اصلاح‌شده):
%   0 = D4  (دینگ)
%   1 = A4
%   2 = Bb4
%   3 = C5
%   4 = D5
%   5 = E5
%   6 = F5
%   7 = G5
%   8 = A5
%
% هر رقم = یک نت هشتم. اعداد چندرقمی مثل "44" یا "1234" یعنی
% نت‌ها پشت سر هم نواخته می‌شوند. مورد آخر "(0,4)" چون با ویرگول
% بود، به‌صورت آکورد (دینگ + D همزمان) درش آوردم.
% ============================================================

melody = {
  \key d \minor
    \clef treble

      % --- بخش A ---
        a'8 c'' d'' d'' d'' e'' f'' f'' \bar "|"
          f'' g'' e'' e'' e'' d'' c'' d'' \bar "|"
            a'8 c'' d'' d'' d'' e'' f'' f'' \bar "|"
              f'' g'' e'' e'' e'' d'' c'' d'' \bar "|"

                % --- بخش B ---
                  a'8 c'' d'' d'' d'' f'' g'' g'' \bar "|"
                    g'' a'' bes' bes' a'' g'' a'' d'' \bar "|"
                      d'' e'' f'' f'' g'' a'' d'' \bar "|"
                        d'' f'' e'' e'' f'' d'' e'' \bar "|"

                          % --- تکرار بخش A ---
                            a'8 c'' d'' d'' d'' e'' f'' f'' \bar "|"
                              f'' g'' e'' e'' e'' d'' c'' d'' \bar "|"
                                a'8 c'' d'' d'' d'' e'' f'' f'' \bar "|"
                                  f'' g'' e'' e'' e'' d'' c'' d'' \bar "|"

                                    % --- تکرار بخش B ---
                                      a'8 c'' d'' d'' d'' f'' g'' g'' \bar "|"
                                        g'' a'' bes' bes' a'' g'' a'' d'' \bar "|"
                                          d'' e'' f'' f'' g'' a'' d'' \bar "|"
                                            d'' f'' e'' e'' f'' d'' e'' \bar "|"

                                              % --- بخش C ---
                                                a'8 bes' c'' d'' a'' a'' a'' a'' d'' \bar "|"
                                                  g'' g'' g'' f'' a'' \bar "|"
                                                    c'' d'' e'' f'' a'' a'' a'' a'' d'' \bar "|"
                                                      g'' f'' e'' d'' \bar "|"

                                                        % --- تکرار بخش C (خط آخر با آکورد پایانی) ---
                                                          a'8 bes' c'' d'' a'' a'' a'' a'' d'' \bar "|"
                                                            g'' g'' g'' f'' a'' \bar "|"
                                                              c'' d'' e'' f'' a'' a'' a'' a'' d'' \bar "|"
                                                                g'' f'' e'' <d' d''>4 \bar "|."
                                                                }

                                                                \score {
                                                                  \new Staff \melody
                                                                    \layout { }
                                                                      \midi { }
                                                                      }
                                                                      